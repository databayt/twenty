{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<workspace>[^.]+)\\.crm\\.databayt\\.org"
        }
      ],
      "destination": "https://:workspace.databayt.org/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
