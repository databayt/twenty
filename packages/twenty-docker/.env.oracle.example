# Twenty CRM — single-host (Oracle Always Free) environment template.
#
# Copy to `.env` and fill in. `./oracle-deploy.sh` will create `.env` from this
# file and auto-generate the secrets/password for you if they're left blank.
# The real `.env` is gitignored — never commit it.

# Your domain (DNS A record must point at this VM).
DOMAIN=crm.databayt.org

# Email used by Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com

# Twenty image tag. `latest` is fine; pin (e.g. v2.12) for reproducibility.
TAG=latest

# ── Database (bundled Postgres on this VM) ────────────────────────────────
# Leave the password blank and oracle-deploy.sh generates a strong one.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
#
# To use external Postgres (e.g. Neon) instead of the bundled db, comment out
# the bundled `db` service in docker-compose.oracle.yml and set a full URL here
# by editing the compose `PG_DATABASE_URL` to your provider's connection string.

# ── Redis (bundled) ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secrets (auto-generated by oracle-deploy.sh if left blank) ────────────
# Or generate manually: openssl rand -base64 32
ENCRYPTION_KEY=
APP_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
# Multi-tenant is OFF by default (single workspace at https://DOMAIN). Do NOT
# set IS_MULTIWORKSPACE_ENABLED here — the server reads it by truthiness, so
# "false" would wrongly turn it ON. To enable workspace subdomains, uncomment
# the two lines in docker-compose.oracle.yml's server service and update
# Caddyfile.oracle (see ORACLE_FREE_DEPLOY.md > "Multi-tenant subdomains").
