# twenty-api — Slice 0 (strangler facade) configuration.
# The only thing needed at this stage: where the legacy NestJS twenty-server lives.
# Everything except the native routes (/healthz) is proxied there.

# Production: the running twenty-server (e.g. the Oracle/Hetzner deploy from HANDOFF.md).
LEGACY_SERVER_URL=http://localhost:3000

# Slice 1+ (Prisma data layer): Postgres / Neon (use the pooled -pooler URL on Vercel).
DATABASE_URL=postgres://user:pass@localhost:5432/default

# Slice 2 (auth): must match the twenty-server APP_SECRET so the same tokens verify.
APP_SECRET=replace_me_with_a_random_string

# Slice 4 (background jobs, Inngest). DEV: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev
# -u http://localhost:3002/api/inngest` — no keys needed. PROD (Inngest Cloud): set both keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
