// Prisma data layer for twenty-api. Prisma owns the STATIC surface (the `core` + `metadata` Postgres
// schemas Twenty creates). Per-workspace OBJECT data lives in a schema-per-workspace and is read with
// raw SQL + the workspace's schema name (see app/lib/workspace.ts) — Prisma has no runtime dynamic
// schema generation, which mirrors Twenty's own split (TypeORM core + a bespoke runner). The models
// here are PARTIAL on purpose: only the columns twenty-api needs are declared; the table's many other
// columns are ignored on read. See .claude/docs/VERCEL-BACKEND.md.

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

// Partial model of core.workspace — enough to resolve a tenant to its dedicated Postgres schema.
model Workspace {
  id              String  @id @db.Uuid
  displayName     String?
  subdomain       String
  databaseSchema  String?
  metadataVersion Int     @default(1)

  @@map("workspace")
  @@schema("core")
}

// Instance-scoped EC P-256 signing keys (rotating). We only read the plaintext SPKI publicKey to
// verify ES256 access/API-key tokens by their header `kid`; the privateKey column is encrypted and
// not needed for verification.
model SigningKey {
  id        String    @id @db.Uuid
  publicKey String
  revokedAt DateTime? @db.Timestamptz(6)

  @@map("signingKey")
  @@schema("core")
}

// API keys are stateless JWTs; this table only holds metadata. We look a key up by its `jti` claim
// to enforce revocation/expiry (the JWT itself can't be revoked).
model ApiKey {
  id          String    @id @db.Uuid
  name        String
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  workspaceId String    @db.Uuid

  @@map("apiKey")
  @@schema("core")
}

// Membership join — used to verify an ACCESS token's userWorkspaceId belongs to its user + workspace.
model UserWorkspace {
  id          String @id @db.Uuid
  userId      String @db.Uuid
  workspaceId String @db.Uuid

  @@map("userWorkspace")
  @@schema("core")
}

// --- Slice 3: metadata-driven migration runner (partial models; objectMetadata/fieldMetadata live
// in the `core` schema in this build, not a separate `metadata` schema). ---

// An object definition; its physical table lives in the workspace schema, named from nameSingular
// (custom objects get a leading underscore — see computeObjectTargetTable).
model ObjectMetadata {
  id           String  @id @db.Uuid
  nameSingular String
  namePlural   String
  isCustom     Boolean @default(false)
  isSystem     Boolean @default(false)
  isActive     Boolean @default(true)
  workspaceId  String  @db.Uuid

  @@map("objectMetadata")
  @@schema("core")
}

// --- Slice 6: object-level permissions. role / roleTarget / objectPermission all live in `core`. ---

// A role's DEFAULT object-record + settings flags (partial model — only what the check reads).
model Role {
  id                            String  @id @db.Uuid
  canReadAllObjectRecords       Boolean @default(false)
  canUpdateAllObjectRecords     Boolean @default(false)
  canSoftDeleteAllObjectRecords Boolean @default(false)
  canDestroyAllObjectRecords    Boolean @default(false)
  canUpdateAllSettings          Boolean @default(false)
  workspaceId                   String  @db.Uuid

  @@map("role")
  @@schema("core")
}

// Links one role to exactly one principal (userWorkspace | apiKey | agent).
model RoleTarget {
  id              String  @id @db.Uuid
  roleId          String  @db.Uuid
  userWorkspaceId String? @db.Uuid
  apiKeyId        String? @db.Uuid
  agentId         String? @db.Uuid
  workspaceId     String  @db.Uuid

  @@map("roleTarget")
  @@schema("core")
}

// Per-(role, object) override. Booleans are NULLABLE — null means "inherit the role default".
model ObjectPermission {
  id                         String   @id @db.Uuid
  roleId                     String   @db.Uuid
  objectMetadataId           String   @db.Uuid
  canReadObjectRecords       Boolean?
  canUpdateObjectRecords     Boolean?
  canSoftDeleteObjectRecords Boolean?
  canDestroyObjectRecords    Boolean?
  workspaceId                String   @db.Uuid

  @@map("objectPermission")
  @@schema("core")
}

// A field definition; for a scalar type the physical column name is `name` verbatim. Partial model —
// only the columns this slice writes/reads. id/createdAt/updatedAt + the boolean flags fall back to
// their DB defaults; objectMetadataId/type/name/label/workspaceId/universalIdentifier/applicationId
// are NOT NULL with no default and must be supplied.
model FieldMetadata {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  objectMetadataId    String   @db.Uuid
  type                String
  name                String
  label               String
  isCustom            Boolean  @default(false)
  isActive            Boolean  @default(false)
  isSystem            Boolean  @default(false)
  isNullable          Boolean? @default(true)
  defaultValue        Json?
  workspaceId         String   @db.Uuid
  universalIdentifier String   @db.Uuid
  applicationId       String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @db.Timestamptz(6)

  @@map("fieldMetadata")
  @@schema("core")
}

// Used to resolve the workspace's "Custom" application id (fieldMetadata.applicationId is NOT NULL).
model Application {
  id          String @id @db.Uuid
  name        String
  workspaceId String @db.Uuid

  @@map("application")
  @@schema("core")
}
