{
  "name": "twenty-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-api",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "next build", "cwd": "packages/twenty-api" },
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev -p 3002", "cwd": "packages/twenty-api" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "next start", "cwd": "packages/twenty-api" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "packages/twenty-api" },
      "cache": true
    }
  }
}
